<?xml version="1.0" encoding="utf-8"?>
<!-- Directory.Build.props: WDK NuGet 包 (packages/) 注入内核编译依赖。
     AdditionalIncludeDirectories 会被 WDK toolset 覆写 → 改用 AdditionalOptions
     (直接 /I 开关硬注入 cl.exe 命令行, 不受任何 MSBuild 属性覆盖影响)。
     LIBPATH 同理: /LIBPATH 直接传给链接器。 -->
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <WDKContentRoot>$(MSBuildThisFileDirectory)packages\</WDKContentRoot>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalOptions>
        /I"$(WDKContentRoot)Include\10.0.26100.0\km"
        /I"$(WDKContentRoot)Include\10.0.26100.0\shared"
        %(AdditionalOptions)
      </AdditionalOptions>
    </ClCompile>
    <Link>
      <AdditionalOptions>
        /LIBPATH:"$(WDKContentRoot)Lib\10.0.26100.0\km\x64"
        %(AdditionalOptions)
      </AdditionalOptions>
    </Link>
  </ItemDefinitionGroup>
</Project>
